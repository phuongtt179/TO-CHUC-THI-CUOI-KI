# Firebase Configuration
# Lấy từ Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Gemini AI API Key (Google AI Studio: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_key_here

# Cloudinary - dùng để lưu ảnh câu hỏi
# Lấy từ: https://cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Tạo tại: Settings → Upload → Upload presets → Add upload preset (Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
